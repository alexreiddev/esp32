// SAFEHOUSE relay node: an open Wi-Fi access point with a captive portal that
// serves one chapter of a campaign (see ../campaigns/*.json).
//
// Content comes from campaign_data.h, generated by tools/build_campaign.py.
// Pick the chapter with NODE_INDEX in node_config.h (or a PlatformIO env).

#include <WiFi.h>
#include <DNSServer.h>
#include <WebServer.h>
#include <MD5Builder.h>
#include <Preferences.h>

#include "node_config.h"
#include "campaign_data.h"

static_assert(NODE_INDEX >= 1 && NODE_INDEX <= NODE_COUNT, "NODE_INDEX out of range for this campaign");

static const NodeContent& N = NODES[NODE_INDEX - 1];

static DNSServer dns;
static WebServer server(80);
static Preferences prefs;

// ------------------------------------------------------------------ stats

struct Stats { uint32_t visits, attempts, unlocks, endingA, endingB; };
static Stats stats;

static void loadStats() {
  stats.visits   = prefs.getUInt("visits", 0);
  stats.attempts = prefs.getUInt("attempts", 0);
  stats.unlocks  = prefs.getUInt("unlocks", 0);
  stats.endingA  = prefs.getUInt("endA", 0);
  stats.endingB  = prefs.getUInt("endB", 0);
}

static void bump(const char* key, uint32_t& field) {
  field++;
  prefs.putUInt(key, field);
}

// --------------------------------------------------------- rate limiting

struct ClientSlot { uint32_t ip; uint8_t wrong; uint32_t lockedUntil; uint32_t lastSeen; };
static ClientSlot slots[AP_MAX_CLIENTS * 2];

static ClientSlot& slotFor(uint32_t ip) {
  ClientSlot* oldest = &slots[0];
  for (auto& s : slots) {
    if (s.ip == ip) return s;
    if (s.lastSeen < oldest->lastSeen) oldest = &s;
  }
  *oldest = {ip, 0, 0, (uint32_t)millis()};
  return *oldest;
}

static bool isLocked(const ClientSlot& s) {
  return s.lockedUntil && (int32_t)(s.lockedUntil - millis()) > 0;
}

// --------------------------------------------------------------- helpers

static String md5Hex(const String& in) {
  MD5Builder md5;
  md5.begin();
  md5.add(in);
  md5.calculate();
  return md5.toString();
}

static String normalise(String s) {
  s.trim();
  s.toLowerCase();
  return s;
}

static const char CSS[] PROGMEM = R"css(
:root{--bg:#0b120e;--panel:#121d17;--line:#24382c;--ink:#d9e7dc;--dim:#8aa393;--acc:#5fd38d;--warn:#f0b44c;--bad:#ef6b6b}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.5 system-ui,sans-serif}
main{max-width:640px;margin:0 auto;padding:16px}
header{border-bottom:1px solid var(--line);padding-bottom:8px;margin-bottom:12px}
.k{font:12px/1.4 ui-monospace,monospace;letter-spacing:.08em;color:var(--dim);text-transform:uppercase}
h1{font-size:1.35em;margin:.2em 0}h2{font-size:1em;margin:0 0 .4em;color:var(--acc)}
.card{background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:14px;margin:12px 0}
.term{font:14px/1.5 ui-monospace,monospace;color:var(--acc);min-height:1.5em}
.tag{display:inline-block;font:11px ui-monospace,monospace;padding:2px 8px;border-radius:99px;border:1px solid currentColor}
.ok{color:var(--acc)}.warn{color:var(--warn)}.bad{color:var(--bad)}
ul{padding-left:1.2em;margin:.3em 0}li{margin:.25em 0}
input,button{font:inherit;width:100%;padding:12px;border-radius:8px;border:1px solid var(--line);background:#0e1712;color:var(--ink)}
button{background:var(--acc);color:#06210f;border:0;font-weight:600;margin-top:8px;cursor:pointer}
button.alt{background:transparent;color:var(--ink);border:1px solid var(--line)}
small,.dim{color:var(--dim)}footer{font-size:12px;color:var(--dim);margin:24px 0 8px}
)css";

static void pageStart(String& h, const char* subtitle) {
  h.reserve(6144);
  h += F("<!doctype html><html lang=en><head><meta charset=utf-8>"
         "<meta name=viewport content='width=device-width,initial-scale=1'><title>");
  h += N.title;
  h += F("</title><style>");
  h += FPSTR(CSS);
  h += F("</style></head><body><main><header><div class=k>");
  h += CAMPAIGN_TITLE;
  h += F(" &middot; Ch ");
  h += N.order;
  h += F("/");
  h += NODE_COUNT;
  h += F("</div><h1>");
  h += N.title;
  h += F("</h1><div class=k>");
  h += subtitle;
  h += F("</div></header>");
}

static void pageEnd(String& h) {
  h += F("<footer>");
  h += CAMPAIGN_FICTION_NOTICE;
  h += F("</footer></main></body></html>");
}

static void sendPage(String& h, int code = 200) {
  server.sendHeader("Cache-Control", "no-store");
  server.send(code, "text/html; charset=utf-8", h);
}

static void safetyCard(String& h) {
  h += F("<div class=card><h2 class=warn>Field safety</h2><ul>");
  for (uint8_t i = 0; i < N.safetyCount; i++) {
    h += F("<li>");
    h += N.safety[i];
    h += F("</li>");
  }
  h += F("</ul></div>");
}

static void answerForm(String& h, const char* error) {
  h += F("<div class=card><h2>Node password</h2><p>");
  h += N.puzzlePrompt;
  h += F("</p>");
  if (error) {
    h += F("<p class=bad>");
    h += error;
    h += F("</p>");
  }
  h += F("<form method=post action=/unlock autocomplete=off>"
         "<input name=a inputmode=text required maxlength=32 placeholder='Enter password'>"
         "<button>Transmit</button></form></div>");
}

// -------------------------------------------------------------- handlers

static void handleRoot() {
  bump("visits", stats.visits);
  String h;
  pageStart(h, N.locationName);

  h += F("<div class='card term' id=t data-s=\"");
  h += N.portalScene;
  h += F("\">");
  h += N.portalScene;
  h += F("</div><script>(function(){var e=document.getElementById('t'),s=e.textContent,i=0;"
         "e.textContent='';(function f(){e.textContent=s.slice(0,++i)+(i<s.length?'\\u2588':'');"
         "if(i<s.length)setTimeout(f,28)})()})()</script>");

  if (N.requiresEvent) {
    h += F("<div class=card><span class='tag warn'>Guided event only</span>"
           "<p>This node is part of a scheduled daytime event with a certified guide. "
           "If you are not on the event, do not continue to the trail.</p></div>");
  }

  h += F("<div class=card><h2>Briefing &middot; ");
  h += CAMPAIGN_HANDLER;
  h += F("</h2><p>");
  h += N.briefing;
  h += F("</p></div>");

  h += F("<div class=card><h2>Local record</h2><p>");
  h += N.mythText;
  h += F("</p><p><span class='tag ");
  h += (strcmp(N.mythStatus, "VERIFIED") == 0) ? "ok" : "warn";
  h += F("'>");
  h += N.mythStatus;
  h += F("</span> <small>");
  h += N.mythSource;
  h += F("</small></p></div>");

  if (N.taskCount) {
    h += F("<div class=card><h2>Objectives</h2><ul>");
    for (uint8_t i = 0; i < N.taskCount; i++) {
      h += F("<li><span class=k>");
      h += N.tasks[i].type;
      h += F("</span> ");
      h += N.tasks[i].prompt;
      h += F("</li>");
    }
    h += F("</ul></div>");
  }

  safetyCard(h);
  answerForm(h, nullptr);
  pageEnd(h);
  sendPage(h);
}

static void handleUnlock() {
  ClientSlot& s = slotFor((uint32_t)server.client().remoteIP());
  s.lastSeen = millis();

  if (isLocked(s)) {
    String h;
    pageStart(h, N.locationName);
    answerForm(h, "Too many failed attempts. Node is cooling down; try again in a minute.");
    pageEnd(h);
    sendPage(h, 429);
    return;
  }

  bump("attempts", stats.attempts);
  String ans = normalise(server.arg("a"));
  if (ans.length() == 0 || md5Hex(ans) != N.answerHash) {
    if (++s.wrong >= MAX_WRONG_ATTEMPTS) {
      s.wrong = 0;
      s.lockedUntil = millis() + LOCKOUT_MS;
    }
    String h;
    pageStart(h, N.locationName);
    answerForm(h, "Access denied. Signal rejected by node.");
    pageEnd(h);
    sendPage(h, 403);
    return;
  }

  s.wrong = 0;
  bump("unlocks", stats.unlocks);
  Serial.printf("[node %d] unlock from %s\n", NODE_INDEX, server.client().remoteIP().toString().c_str());

  String h;
  pageStart(h, "Node unlocked");
  h += F("<div class=card><span class='tag ok'>Access granted</span><h2 style='margin-top:.6em'>Intel recovered</h2><p>");
  h += N.intel;
  h += F("</p><p class=k>Unlock code: <b class=ok>");
  h += N.unlockCode;
  h += F("</b></p><small>Note this code; it proves you cleared ");
  h += N.chapterId;
  h += F(".</small></div>");

  if (N.fieldQuestion[0]) {
    h += F("<div class=card><h2>Field question</h2><p>");
    h += N.fieldQuestion;
    h += F("</p><small>Answer for your team debrief; this node does not check it.</small></div>");
  }
  if (N.interview[0]) {
    h += F("<div class=card><h2>Interview lead</h2><p>");
    h += N.interview;
    h += F("</p><small>Only if your host is happy to chat. Be polite and brief.</small></div>");
  }

  if (N.finale) {
    h += F("<div class=card><h2>Final decision</h2><p>The master dossier is yours. What happens to it?</p>"
           "<form method=post action=/ending><input type=hidden name=c value='");
    h += N.unlockCode;
    h += F("'><button name=e value=a>");
    h += CAMPAIGN_ENDING_A;
    h += F("</button><button class=alt name=e value=b>");
    h += CAMPAIGN_ENDING_B;
    h += F("</button></form></div>");
  } else {
    h += F("<div class=card><h2>Next</h2><p>Disconnect from this node and await CANOPY-7's next coordinates.</p></div>");
  }

  pageEnd(h);
  sendPage(h);
}

static void handleEnding() {
  if (!N.finale || server.arg("c") != N.unlockCode) {
    server.sendHeader("Location", "/", true);
    server.send(302, "text/plain", "");
    return;
  }
  String e = server.arg("e");
  if (e == "a") bump("endA", stats.endingA);
  else if (e == "b") bump("endB", stats.endingB);

  String h;
  pageStart(h, "Season complete");
  h += F("<div class=card><h2>Decision logged</h2><p>");
  h += (e == "a") ? CAMPAIGN_ENDING_A : CAMPAIGN_ENDING_B;
  h += F("</p></div><div class=card><h2>Incoming &middot; ");
  h += CAMPAIGN_HANDLER;
  h += F("</h2><p>");
  h += CAMPAIGN_SEASON2_HOOK;
  h += F("</p></div>");
  pageEnd(h);
  sendPage(h);
}

static void handleOps() {
  if (server.arg("key") != OPS_KEY) {
    server.send(403, "text/plain", "forbidden");
    return;
  }
  char buf[320];
  snprintf(buf, sizeof(buf),
           "{\"node\":\"%s\",\"ssid\":\"%s\",\"uptime_s\":%lu,\"clients\":%d,"
           "\"visits\":%u,\"attempts\":%u,\"unlocks\":%u,\"ending_a\":%u,\"ending_b\":%u}",
           N.nodeId, N.ssid, (unsigned long)(millis() / 1000), WiFi.softAPgetStationNum(),
           (unsigned)stats.visits, (unsigned)stats.attempts, (unsigned)stats.unlocks,
           (unsigned)stats.endingA, (unsigned)stats.endingB);
  server.send(200, "application/json", buf);
}

static void redirectToPortal() {
  server.sendHeader("Location", String("http://") + AP_IP.toString() + "/", true);
  server.send(302, "text/plain", "");
}

// ----------------------------------------------------------------- setup

void setup() {
  Serial.begin(115200);
  if (STATUS_LED_PIN >= 0) pinMode(STATUS_LED_PIN, OUTPUT);

  prefs.begin("safehouse", false);
  loadStats();

  WiFi.mode(WIFI_AP);
  WiFi.softAPConfig(AP_IP, AP_IP, AP_NETMASK);
  WiFi.softAP(N.ssid, nullptr, AP_CHANNEL, 0, AP_MAX_CLIENTS);

  // Answer every DNS query with our IP so phones pop the captive portal.
  dns.setErrorReplyCode(DNSReplyCode::NoError);
  dns.start(53, "*", AP_IP);

  server.on("/", HTTP_GET, handleRoot);
  server.on("/unlock", HTTP_POST, handleUnlock);
  server.on("/unlock", HTTP_GET, redirectToPortal);
  server.on("/ending", HTTP_POST, handleEnding);
  server.on("/ops", HTTP_GET, handleOps);
  // Android, iOS/macOS and Windows connectivity probes all fall through here.
  server.onNotFound(redirectToPortal);
  server.begin();

  Serial.printf("SAFEHOUSE %s (%s) up: SSID %s at %s\n",
                N.nodeId, N.chapterId, N.ssid, AP_IP.toString().c_str());
}

void loop() {
  dns.processNextRequest();
  server.handleClient();

  if (STATUS_LED_PIN >= 0) {
    // Slow blink while idle, fast blink when someone is connected.
    uint32_t period = WiFi.softAPgetStationNum() ? 250 : 1500;
    digitalWrite(STATUS_LED_PIN, (millis() / period) % 2);
  }
}
